{
  "manifest_version": 3,
  "name": "Math for Basecamp",
  "version": "0.0.0",
  "description": "Unofficial. Type LaTeX math in Basecamp: $...$ inline, $$ + Enter for a block, rendered with KaTeX.",
  "homepage_url": "https://github.com/CharlieLeee/lexxy-math-basecamp",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://3.basecamp.com/*", "https://app.basecamp.com/*"],
      "js": ["lexxy-math.js", "loader.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
